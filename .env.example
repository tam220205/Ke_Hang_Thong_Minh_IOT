# Copy to .env and fill locally, or run: python tools/setup_security.py
# Never commit .env. Use single quotes so "$" in bcrypt hashes is not expanded.
TELEGRAM_BOT_TOKEN=''
TELEGRAM_CHAT_IDS=''

# MQTT broker used by Node-RED (TLS). For local Mosquitto: MQTT_HOST='mosquitto', MQTT_PORT='1883'
MQTT_HOST='broker.hivemq.com'
MQTT_PORT='8883'

# Shared HMAC-SHA256 key (>= 16 chars): same value in include/secrets.h and the dashboard
SHELF_HMAC_KEY=''

# Node-RED editor login. Hash: docker compose run --rm nodered node-red admin hash-pw
NODERED_ADMIN_USER='admin'
NODERED_ADMIN_PASSWORD_HASH=''
NODERED_CREDENTIAL_SECRET=''
