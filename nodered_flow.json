  {
    "id": "fn_check_stock",
    "type": "function",
    "z": "tab_smart_shelf",
    "name": "Kiểm tra ngưỡng & Chống spam",
    "func": "// Lưu trạng thái cảnh báo trước đó vào context của Node-RED\nlet lastAlerts = context.get('lastAlerts') || {};\nlet now = Date.now();\nlet interval = 5 * 60 * 1000; // Nhắc lại mỗi 5 phút\n\nlet shelves = msg.payload.shelves || [];\nlet alertMessages = [];\n\nfor (let shelf of shelves) {\n    if (shelf.low_stock) {\n        let lastTime = lastAlerts[shelf.id] || 0;\n        if (now - lastTime >= interval) {\n            alertMessages.push(`⚠️ *KỆ [${shelf.id}] - ${shelf.name}*: Còn ${shelf.qty} món (Tải trọng: ${shelf.weight}g, Ngưỡng: ${shelf.min})`);\n            lastAlerts[shelf.id] = now;\n        }\n    } else {\n        // Reset khi đã bổ sung hàng\n        delete lastAlerts[shelf.id];\n    }\n}\n\ncontext.set('lastAlerts', lastAlerts);\n\nif (alertMessages.length > 0) {\n    let text = `🚨 *[CẢNH BÁO KHO HÀNG - NHÓM 22]*\\n\\n` + alertMessages.join('\\n') + `\\n\\n👉 *Vui lòng tiếp thêm hàng vào kệ!*`;\n    \n    // Chuẩn bị payload gửi Telegram qua HTTP REST API\n    msg.payload = {\n        chat_id: \"8349343826\",\n        text: text,\n        parse_mode: \"Markdown\"\n    };\n    return msg;\n}\n\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 200,
    "wires": [
      [
        "http_telegram_alert"
      ]
    ]
  },
